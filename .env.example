# Copy to .env (gitignored) and fill in. Used by the tests; the Edge Function
# reads the same names from its secrets (`npx supabase secrets set ...`).

# Login password for the meetup_api database role (set once by hand, see README).
MEETUP_API_DB_PASSWORD=

# Shared pooler host for your project's region (not a secret),
# e.g. aws-0-ap-south-1.pooler.supabase.com. Dashboard → Connect → Transaction pooler.
MEETUP_API_DB_HOST=
